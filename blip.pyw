def awaken_stage(kind):
    """0 for a normal Blip, 1 for its first Awakened form, 2 and 3 for deeper ones."""
    base = AWAKEN_BASE.get(kind)
    return AWAKEN_CHAIN[base].index(kind) + 1 if base else 0

