def quest_hash(text):
    h = 2166136261
    for b in text.encode("utf-8"):
        h = ((h ^ b) * 16777619) & 0xFFFFFFFF
    return h


def todays_quests(day=None):
    day = day or time.strftime("%Y-%m-%d")
    return sorted(QUESTS, key=lambda q: quest_hash(day + q["id"]))[:3]


def event_paused():
    """While the game is closed for maintenance the event (and daily quests) are paused, and the end date moves back."""
    today = time.strftime("%Y-%m-%d")
    a, b = EVENT.get("paused") or ["", ""]
    return bool(a) and a <= today < b


def event_on():
    today = time.strftime("%Y-%m-%d")
    return (EVENT["start"] <= today or EARLY_EVENT) and today <= EVENT["until"] and not event_paused()


def skin_locked(save, kind, idx):
    """Event skins (and special unlockable colors, like the Shadow crew) stay locked until you earn them."""
    cols = kind_colors(kind)
    col = cols[idx % len(cols)]
    return bool(col.get("event") or col.get("unlock")) and f"{kind}:{col['name']}" not in save.get("skins", [])


