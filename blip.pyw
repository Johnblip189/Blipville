EGG = [
    "....oooo....",
    "...oeeeeo...",
    "..oeesseeo..",
    ".oeeeeeeseo.",
    ".oeseeeeeeo.",
    "oeeeeeeeeseo",
    "oeeesseeeeeo",
    "oeeeeeeeeeeo",
    "oeseeeeeesso",
    ".oeeeeeeeeo.",
